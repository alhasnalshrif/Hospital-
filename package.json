{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "description": "Hospital Management System Backend with Node.js and Drizzle ORM",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate:pg",
